<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_Layout_VHStackLayoutEx.MainPage">


	<!-- Main vertical container for the entire UI -->
	<VerticalStackLayout Margin="20" Spacing="50">

		<!-- Header section -->
		<Label Text="Registration Form" 
               FontSize="24" 
               HorizontalOptions="Center" />
		
		<!-- Horizontal container for name input -->
		<HorizontalStackLayout Spacing="10">
			<Label Text="Name:" VerticalOptions="Center" 
                   WidthRequest="100" />
			<Entry Placeholder="Enter full name" x:Name="enFullName" WidthRequest="200"/>
		</HorizontalStackLayout>

		<!-- Horizontal container for email input -->
		<HorizontalStackLayout Spacing="10">
			<Label Text="Email:" VerticalOptions="Center" 
                   WidthRequest="100" />
			<Entry Placeholder="Enter email address" WidthRequest="200"
                   Keyboard="Email" x:Name="enEmail" />
		</HorizontalStackLayout>

		<!-- Horizontal button container -->
		<HorizontalStackLayout Spacing="50" HorizontalOptions="Center">
			<Button Text="Submit" WidthRequest="120" 
                    BackgroundColor="LightBlue" Clicked="btSubmit_Clicked"/>
			<Button Text="Cancel" WidthRequest="120" 
                    BackgroundColor="LightCoral" Clicked="btCancel_Clicked"/>
		</HorizontalStackLayout>
	</VerticalStackLayout>


</ContentPage>
